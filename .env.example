# ---------------------------------------------------------------------------
# OmniRoute on Vercel — environment variables
# Set these in Vercel Project Settings > Environment Variables (Dev/Preview/Prod).
# ---------------------------------------------------------------------------

# REQUIRED. Dashboard login password (single-admin, personal use).
ADMIN_PASSWORD=change-me-to-a-long-random-password

# REQUIRED. Secret used to sign the dashboard session cookie (any long random string).
AUTH_SECRET=change-me-to-another-long-random-string

# REQUIRED. The key CLI tools and SDK clients send as "Authorization: Bearer <GATEWAY_KEY>".
GATEWAY_KEY=change-me-to-a-gateway-key

# REQUIRED. 64 hex characters (32 bytes) — AES-256-GCM key used to encrypt
# provider API keys at rest in the Blob store. Generate: openssl rand -hex 32
# Losing this key makes stored provider keys unrecoverable — back it up.
CREDENTIAL_ENCRYPTION_KEY=

# Provided automatically by Vercel when you attach a Blob store to the project
# (Dashboard > Storage > Create Blob store). Do not set it by hand.
# BLOB_READ_WRITE_TOKEN=

# Outbound request timeout per provider, in milliseconds (default 60000).
GATEWAY_TIMEOUT_MS=60000
